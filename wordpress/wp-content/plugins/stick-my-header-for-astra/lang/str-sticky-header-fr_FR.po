msgid "Header Z-Index. Default value : 1. If your header is not visible, set this to 1000 minimum"
msgstr "Z-index du header. Valeur par défaut : 1. Si votre en-tête (header) n est pas visible, réglez cette valeur à 1000 minimum"

#: inc/customizer.php:124 inc/customizer.php:292 inc/customizer.php:636
msgid "Border Bottom Size (px)"
msgstr "Bordure Inférieure - Taille (px)"

#: inc/customizer.php:125
msgid "Header Border Bottom Size. Default value : unset."
msgstr "Taille de la bordure inférieure de l en-tête (header). Valeur par défaut : non définie."

#: inc/customizer.php:138 inc/customizer.php:306 inc/customizer.php:650
msgid "Border Bottom Color"
msgstr "Bordure inférieure - Couleur"

#: inc/customizer.php:139
msgid "Header Border Bottom Color. Default value : unset."
msgstr "Couleur de la bordure inférieure de l en-tête (header). Valeur par défaut : non définie."

#: inc/customizer.php:147 inc/customizer.php:659
msgid "HEADER SHADOW"
msgstr "OMBRE DE L'EN-TÊTE"

#: inc/customizer.php:148
msgid "Here, you can edit your website's header shadow settings when it is not sticky (in the top page)."
msgstr "Ici, vous pouvez modifier les paramètres de l'ombre de l'en-tête (header shadow) de votre site web lorsque le header est en haut de la page (position initiale)."

#: inc/customizer.php:149 inc/customizer.php:317 inc/customizer.php:389
