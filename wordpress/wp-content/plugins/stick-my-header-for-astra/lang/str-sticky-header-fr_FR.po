msgid "Background Color"
msgstr "Fond - Couleur"

#: inc/customizer.php:67
msgid "Header Background Color. Default value : none"
msgstr "Couleur de fond du header. Valeur par défaut : aucune"

#: inc/customizer.php:89 inc/customizer.php:257 inc/customizer.php:620
msgid "Background Opacity"
msgstr "Fond - Opacité"

#: inc/customizer.php:90
msgid "Header Background Opacity. Default value : 1. You can edit it from 0 to 1 only"
msgstr "Opacité de fond du header. Valeur par défaut : 1. Vous pouvez la modifier de 0 à 1 uniquement"

